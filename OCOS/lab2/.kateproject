{
    "name": "OCOS",
    "files": [
        {
            "recursive": true,
            "filters": ["*.jl", "*.lua"]
        }
    ],
    "build": {
        "directory": ".",
        "targets": [
            {
                "name": "start",
                "build_cmd": "kitty julia main.jl"
            }
        ],
        "default_target": "Собрать"
    }
}
